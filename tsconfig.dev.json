{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node", "vitest/globals"]
  },
  "include": [
    "index.ts",
    "autotrack.ts",
    "vite.ts",
    "core/**/*.ts",
    "runtime/**/*.ts",
    "platform/**/*.ts",
    "autotrack/**/*.ts",
    "scripts/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "demo",
    "dist",
    "release",
    "test/type/gdp-compiled-consumer.ts",
    "test/type/autotrack-consumer.ts"
  ]
}
