{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["index.ts", "vite.ts", "core/**/*.ts", "runtime/**/*.ts", "platform/**/*.ts", "autotrack/**/*.ts"],
  "exclude": ["node_modules", "demo", "scripts", "test"]
}
